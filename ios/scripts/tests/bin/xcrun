#!/bin/sh
set -eu
state=${FAKE_SIM_STATE:?}
echo "$*" >> "$state/calls"
[ "${1:-}" = simctl ] || exit 1
shift
command=$1
shift

list_devices() {
    echo "== Devices =="
    echo "-- iOS 27.0 --"
    for device in "$state"/device.*; do
        [ -e "$device" ] || continue
        read -r name device_state < "$device"
        if [ "${1:-}" = booted ] && [ "$device_state" != Booted ]; then
            continue
        fi
        echo "    $name (${device##*/device.}) ($device_state) "
    done
}

set_state() {
    read -r name old_state < "$state/device.$1"
    echo "$name $2" > "$state/device.$1"
}

case "$command" in
    list)
        case "$*" in
            "devices booted") list_devices booted ;;
            devices*) list_devices ;;
            "runtimes available") echo "iOS 27.0 (27.0 - 24A434) - com.apple.CoreSimulator.SimRuntime.iOS-27-0" ;;
        esac
        ;;
    create)
        udid=$(uuidgen)
        echo "$1 Shutdown" > "$state/device.$udid"
        echo "$2" > "$state/type.$udid"
        echo "$udid"
        ;;
    bootstatus)
        read -r name old_state < "$state/device.$1"
        if [ "$old_state" != Booted ]; then
            # iOS keeps the clock of the language that the Simulator has when it boots, for the status bar override.
            if [ -n "${FAKE_BOOT_CLOCK_24:-}" ] || { [ "$(cat "$state/global.$1.AppleLocale" 2> /dev/null)" = fr_FR ] \
                && [ ! -e "$state/global.$1.AppleICUForce12HourTime" ]; }; then
                echo 24 > "$state/boot-clock.$1"
            else
                echo 12 > "$state/boot-clock.$1"
            fi
        fi
        set_state "$1" Booted
        ;;
    status_bar)
        case "$2" in
            override)
                if [ "$(cat "$state/boot-clock.$1" 2> /dev/null)" = 24 ]; then
                    echo "09:41" > "$state/status-bar.$1"
                else
                    printf '9:41\342\200\257\n' > "$state/status-bar.$1"
                fi
                ;;
            list)
                echo "Current Status Bar Overrides:"
                echo "============================="
                [ ! -e "$state/status-bar.$1" ] || echo "Time: $(cat "$state/status-bar.$1")"
                ;;
            clear) rm -f "$state/status-bar.$1" ;;
        esac
        ;;
    shutdown) [ -z "${FAKE_SHUTDOWN_FAILS:-}" ] || exit 1; set_state "$1" Shutdown ;;
    listapps)
        touch "$state/apps.$1"
        sed 's/.*/    CFBundleIdentifier = "&";/' "$state/apps.$1"
        ;;
    uninstall)
        grep -vxF "$2" "$state/apps.$1" > "$state/apps.$1.new" || true
        mv "$state/apps.$1.new" "$state/apps.$1"
        ;;
    delete) rm "$state/device.$1" ;;
    get_app_container) touch "$state/apps.$1"; grep -qxF "$2" "$state/apps.$1" ;;
    launch) echo "$2" > "$state/launched.$1" ;;
    getenv) [ "$2" = HOME ] && echo "$state/data.$1" ;;
    ui) [ $# -lt 3 ] || echo "$3" > "$state/ui.$1.$2" ;;
    spawn)
        prefs="$state/prefs.$1"
        touch "$prefs"
        case "$2 $3" in
            "defaults domains") paste -s -d ',' "$prefs" | sed 's/,/, /g' ;;
            "defaults delete")
                if [ "$4" = -g ]; then
                    [ -e "$state/global.$1.$5" ] || exit 1
                    rm "$state/global.$1.$5"
                    exit 0
                fi
                [ -z "${FAKE_DEFAULTS_DELETE_FAILS:-}" ] && grep -qxF "$4" "$prefs" || exit 1
                grep -vxF "$4" "$prefs" > "$prefs.new" || true
                mv "$prefs.new" "$prefs"
                ;;
            "defaults write")
                [ "$4" = -g ] && echo "$7" > "$state/global.$1.$5"
                ;;
            "launchctl kickstart")
                if [ "$5" = user/foreground/com.apple.SpringBoard ]; then
                    touch "$state/apps.$1"
                    cp "$state/apps.$1" "$state/apps-at-springboard-restart.$1"
                    cat "$state/global.$1.AppleLanguages" "$state/global.$1.AppleLocale" 2> /dev/null \
                        | paste -s -d ' ' - > "$state/language-at-springboard-restart.$1"
                    rm -f "$state/popup.$1"
                    notifications="$state/data.$1/Library/BulletinBoard/VersionedSectionInfo.plist"
                    if [ -e "$notifications" ]; then
                        cp "$notifications" "$state/notifications-at-springboard-restart.$1"
                        if [ -n "${FAKE_SPRINGBOARD_SAVES_NOTIFICATIONS:-}" ]; then
                            cp "$FAKE_SPRINGBOARD_SAVES_NOTIFICATIONS" "$notifications"
                        fi
                    fi
                fi
                ;;
            "log show")
                log="$state/chronod-log.$1"
                [ -e "$log" ] || exit 0
                cat "$log"
                if [ -e "$log.next" ]; then
                    mv "$log.next" "$log"
                fi
                ;;
            "launchctl print")
                [ -z "${FAKE_SPRINGBOARD_NOT_READY:-}" ] || exit 0
                printf '\t\t"com.apple.springboard.services" = {\n\t\t\tport = 0x1\n\t\t\tactive = 1\n\t\t}\n'
                ;;
        esac
        ;;
esac
