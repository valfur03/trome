#!/bin/sh
# A fake gh for the tests of e2e-proof.sh and merge.sh: it answers the calls of e2e-proof.sh to the API of GitHub
# from files in $FAKE_GH_STATE, and applies their --jq filter with jq, as gh does.
#   statuses/<sha>.json   the statuses of a commit, the newest first (a POST adds one, written by FAKE_GH_LOGIN, default the owner)
#   calls                 one line per call
#   fail                  when it exists, every call fails as GitHub would when it cannot be reached
# The owner of the repo is FAKE_GH_OWNER (default "owner").
set -eu
state=${FAKE_GH_STATE:?"this fake gh works only in a test that sets FAKE_GH_STATE"}
echo "$*" >> "$state/calls"
[ "${1:-}" = api ] || { echo "fake gh: only 'gh api' is faked" >&2; exit 1; }
shift
method=GET
filter=.
path=
status_state=
status_context=
status_description=
while [ $# -gt 0 ]; do
    case "$1" in
        -X) method=$2; shift 2 ;;
        --jq) filter=$2; shift 2 ;;
        -f)
            case "$2" in
                state=*) status_state=${2#state=} ;;
                context=*) status_context=${2#context=} ;;
                description=*) status_description=${2#description=} ;;
            esac
            shift 2
            ;;
        *) path=$1; shift ;;
    esac
done
if [ -e "$state/fail" ]; then
    echo "error connecting to api.github.com" >&2
    exit 1
fi
mkdir -p "$state/statuses"
case "$method $path" in
    "GET repos/{owner}/{repo}")
        json=$(jq -n --arg login "${FAKE_GH_OWNER:-owner}" '{owner: {login: $login}}')
        ;;
    "GET repos/{owner}/{repo}/commits/"*"/statuses?per_page=100")
        sha=${path#repos/\{owner\}/\{repo\}/commits/}
        sha=${sha%%/*}
        json=$(cat "$state/statuses/$sha.json" 2> /dev/null || echo '[]')
        ;;
    "POST repos/{owner}/{repo}/statuses/"*)
        sha=${path##*/}
        old=$(cat "$state/statuses/$sha.json" 2> /dev/null || echo '[]')
        printf '%s' "$old" | jq --arg state "$status_state" --arg context "$status_context" \
            --arg description "$status_description" --arg login "${FAKE_GH_LOGIN:-${FAKE_GH_OWNER:-owner}}" \
            '[{state: $state, context: $context, description: $description, creator: {login: $login}}] + .' \
            > "$state/statuses/$sha.json.new"
        mv "$state/statuses/$sha.json.new" "$state/statuses/$sha.json"
        json='{}'
        ;;
    *)
        echo "fake gh: no fake answer for $method $path" >&2
        exit 1
        ;;
esac
printf '%s' "$json" | jq -r "$filter"
