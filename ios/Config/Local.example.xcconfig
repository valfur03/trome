// Copy this file to ios/Config/Local.xcconfig to install the app on your iPhone.
// ios/Config/Local.xcconfig is ignored by git.

// Your Personal Team ID (10 letters and digits).
DEVELOPMENT_TEAM =

// A prefix that is unique to you, for example io.github.your-github-name
// The app gets the bundle ID <prefix>.trome.dev, and its Live Activity <prefix>.trome.dev.widget.
// They end with .dev, so they are never the App Store ID of the app (io.github.valfur03.trome), whatever your prefix.
// So your free Apple ID can never register the App Store ID: Apple would then never give it to the paid account of the app.
TROME_BUNDLE_ID_PREFIX = com.example

// Optional: the full bundle IDs of your Debug builds, instead of <prefix>.trome.dev and <prefix>.trome.dev.widget.
// Use them to reuse two bundle IDs that your free Apple ID already registered: a free Apple ID can register only 10 in 7 days.
// The tutorial "Install the app on your iPhone" shows how to list them.
// Write each ID exactly as Xcode registered it, capitals included.
// The ID of the Live Activity must start with the ID of the app and a dot, or iOS does not install it.
// If you set only the app ID, the Live Activity gets the app ID followed by .widget.
// Only Debug builds read them: Release builds keep the App Store IDs.
// Never put the App Store IDs here (io.github.valfur03.trome or io.github.valfur03.trome.widget, in any capitals): a free Apple ID that signs them takes them for good.
// make generate refuses them, and a Run in Xcode gets an ID that starts with SHIPPING_ID_REFUSED, so Apple cannot register it.
// After a change, run make generate: it prints the two IDs that Xcode will use, so check them before you click Run.
// TROME_DEBUG_APP_BUNDLE_ID = io.github.your-github-name.oldapp
// TROME_DEBUG_WIDGET_BUNDLE_ID = io.github.your-github-name.oldapp.widget

// Optional, only when DEVELOPMENT_TEAM is a paid Apple Developer Program team: YES compiles the silent start into your
// Debug builds (the server starts the Live Activity at a station, with no notification and no tap).
// It needs the push capability and an app group (shared by the app and its widget), which a free Apple ID cannot sign, so leave it empty with a Personal Team.
// It also needs your server in ios/Config/Server.xcconfig (a copy of Server.example.xcconfig); with no server, the app notifies as before.
// TROME_SILENT_START = YES

// Optional, only to archive a TestFlight build for a walk: YES puts the Wake log into the Release build whose
// CURRENT_PROJECT_VERSION (ios/Config/Base.xcconfig) is the number at the end of the name, here build 6.
// It records on the phone each wake by iOS, each arrival decision and each ask of the start, and the button at the
// top right of the main screen opens it (ios/guide/testing-tools.md). Debug builds always have it.
// The next build number turns it off by itself, so a store build never has it; remove the line after the walk.
// TROME_WAKE_LOG_BUILD_6 = YES
