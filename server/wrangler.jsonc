{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "trome-server",
  "main": "src/cloudflare/worker.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "observability": { "enabled": false },
  "vars": { "PRIM_DAILY_CAP": "800" },
  "secrets": {
    "required": ["PRIM_API_KEY", "APP_TOKEN", "OWNER_TOKEN"]
  },
  "durable_objects": {
    "bindings": [{ "name": "RELAY", "class_name": "RelayObject" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RelayObject"] }],
  "env": {
    "staging": {
      "name": "trome-server-staging",
      "observability": { "enabled": false },
      "vars": { "PRIM_DAILY_CAP": "60" },
      "secrets": {
        "required": ["PRIM_API_KEY", "APP_TOKEN", "OWNER_TOKEN"]
      },
      "durable_objects": {
        "bindings": [{ "name": "RELAY", "class_name": "RelayObject" }]
      },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RelayObject"] }]
    }
  }
}
