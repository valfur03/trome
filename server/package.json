  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.3.6",
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.1",
    "@vitest/runner": "4.1.11",
    "@vitest/snapshot": "4.1.11",
    "eslint": "10.11.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "4.1.11",
    "wrangler": "4.147.0"
  }
}
