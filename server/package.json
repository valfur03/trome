{
  "name": "ratp-activity-server",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p test/core/tsconfig.json && tsc -p test/cloudflare/tsconfig.json",
    "lint": "eslint .",
