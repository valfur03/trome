---
// A part of the page that is not final yet, such as the description of a version of the app that is not out.
// Put it once, at the top of that part, and say, in the reader's terms, what is not final.
// A page that uses it must also show the DraftNotice: a test checks it.
const french = Astro.locals.starlightRoute.lang.startsWith('fr');
---

<p class="unverified">
  <strong>{french ? 'Pas définitif :' : 'Not final:'}</strong>{' '}
  <slot />
</p>

<style>
  .unverified {
    padding: 0.4em 0.6em;
    border-inline-start: 0.25em solid var(--sl-color-orange);
    background-color: var(--sl-color-orange-low);
    color: var(--sl-color-orange-high);
  }
</style>
