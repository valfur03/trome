---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
}

const { src, alt, caption } = Astro.props;
---

<figure class="screenshot not-content">
  <Picture src={src} alt={alt} width={300} densities={[1, 2, 3]} formats={['avif']} fallbackFormat="webp" />
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .screenshot {
    display: block;
    width: 300px;
    max-width: 100%;
    margin: 1rem 0 0;
  }

  .screenshot :global(img) {
    display: block;
    width: 100%;
    height: auto;
    margin: 0;
    border-radius: 13.5% / 6.2%;
    box-shadow:
      0 0 0 1px var(--sl-color-gray-5),
      0 0.5rem 1.5rem rgb(0 0 0 / 0.15);
  }

  .screenshot figcaption {
    margin-top: 0.75rem;
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-sm);
    text-align: center;
  }
</style>
