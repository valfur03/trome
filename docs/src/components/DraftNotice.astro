---
import { Aside } from '@astrojs/starlight/components';

// Put this notice at the top of a page that is not signed off yet.
// The publish step of the site must refuse a page that still has it.
const french = Astro.locals.starlightRoute.lang.startsWith('fr');
---

{
  french ? (
    <Aside type="caution" title="Brouillon">
      Cette page n’est pas encore validée, et les passages surlignés restent à compléter.
      Elle ne doit pas être mise en ligne dans cet état.
    </Aside>
  ) : (
    <Aside type="caution" title="Draft">
      This page is not signed off yet, and the highlighted parts are still to fill in.
      It must not go online like this.
    </Aside>
  )
}
