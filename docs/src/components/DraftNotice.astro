---
import { Aside } from '@astrojs/starlight/components';

// Put this notice at the top of a page that is not final yet.
// It tells the reader that the page is a draft and that its text can change.
const french = Astro.locals.starlightRoute.lang.startsWith('fr');
---

{
  french ? (
    <Aside type="caution" title="Brouillon">
      Cette page est un brouillon. Les passages surlignés restent à compléter ou ne sont pas encore définitifs, et le texte peut changer.
    </Aside>
  ) : (
    <Aside type="caution" title="Draft">
      This page is a draft. The highlighted parts are still to fill in or not final yet, and the text can change.
    </Aside>
  )
}
