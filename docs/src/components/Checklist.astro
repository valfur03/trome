---
import type { ChecklistKind } from './checklist.ts';

interface Props {
  id: string;
  kind?: ChecklistKind;
}

const { id, kind = 'steps' } = Astro.props;
---

<docs-checklist data-id={id} data-kind={kind}>
  <p class="checklist-progress" aria-live="polite" hidden></p>
  <slot />
</docs-checklist>

<script>
  import { parseTicks, progressLabel, serializeTicks, type ChecklistKind } from './checklist.ts';

  const storageKey = (id: string) => `ratp-docs-checklist:${id}`;

  function readSaved(key: string): string | null {
    try {
      return localStorage.getItem(key);
    } catch {
      return null;
    }
  }

  function save(key: string, value: string) {
    try {
      localStorage.setItem(key, value);
    } catch {
      return;
    }
  }

  class DocsChecklist extends HTMLElement {
    connectedCallback() {
      const key = storageKey(this.dataset.id ?? '');
      const kind: ChecklistKind = this.dataset.kind === 'things' ? 'things' : 'steps';
      const progress = this.querySelector<HTMLElement>('.checklist-progress');
      const steps = [...this.querySelectorAll('li')].filter(
        (step) => step.parentElement?.closest('li, docs-checklist') === this,
      );
      const ticks = parseTicks(readSaved(key), steps.length);

      const render = () => {
        if (progress) {
          progress.textContent = progressLabel(ticks.filter(Boolean).length, steps.length, kind);
          progress.hidden = false;
        }
        steps.forEach((step, index) => step.classList.toggle('checklist-done', ticks[index]));
      };

      steps.forEach((step, index) => {
        const label = document.createElement('label');
        label.className = 'checklist-tick';
        const box = document.createElement('input');
        box.type = 'checkbox';
        box.checked = ticks[index];
        box.setAttribute(
          'aria-label',
          kind === 'things' ? `Thing ${index + 1} ready` : `Step ${index + 1} done`,
        );
        box.addEventListener('change', () => {
          ticks[index] = box.checked;
          save(key, serializeTicks(ticks));
          render();
        });
        label.append(box);
        step.prepend(label);
      });
      render();
    }
  }

  customElements.define('docs-checklist', DocsChecklist);
</script>

<style>
  docs-checklist {
    display: block;
  }

  .checklist-progress {
    position: sticky;
    inset-block-start: calc(var(--sl-nav-height) + var(--sl-mobile-toc-height));
    z-index: 2;
    padding-block: 0.25rem;
    background-color: var(--sl-color-bg);
    font-weight: 600;
    color: var(--sl-color-accent-high);
  }

  docs-checklist :global(:is(h2, h3, h4)) {
    scroll-margin-block-start: 2.5rem;
  }

  docs-checklist :global(.checklist-tick) {
    position: relative;
    float: inline-end;
    margin-inline-start: 0.5rem;
  }

  docs-checklist :global(.checklist-tick::before) {
    content: '';
    position: absolute;
    inset-block-start: calc(50% - 1.375rem);
    inset-inline-start: calc(50% - 1.375rem);
    inline-size: 2.75rem;
    block-size: 2.75rem;
  }

  docs-checklist :global(.checklist-tick input) {
    inline-size: 1.25rem;
    block-size: 1.25rem;
    accent-color: var(--sl-color-accent);
    cursor: pointer;
  }

  docs-checklist :global(li.checklist-done) {
    color: var(--sl-color-gray-3);
  }
</style>
